# Get this token from Telegram's @BotFather.
TELEGRAM_BOT_TOKEN=

# Set one of these two Anthropic credentials.
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional: only set this when using an Anthropic-compatible proxy.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Public Cloud Run URL, without a trailing slash.
WEBHOOK_URL=https://your-service-url.run.app

# 1-256 characters: A-Z, a-z, 0-9, underscore and hyphen only.
WEBHOOK_SECRET_TOKEN=replace-with-a-random-secret

# Cloud Run injects this automatically. Keep 8080 for local development.
PORT=8080
